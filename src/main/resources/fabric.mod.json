{
	"schemaVersion": 1,
	"id": "dtrmc",
	"version": "${version}",
	"name": "Devathip Registry",
	"description": "A mod that allows you to freely change names.",
	"authors": [
		"Bloomery Network Team",
		"xPintoKunG_Z"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/xPintoKunGz/DTRMC"
	},
	"license": "CC0-1.0",
	"icon": "assets/dtrmc/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"bloomery.dtrmc.DTRMC"
		],
		"client": [
			"bloomery.dtrmc.client.DTRMCClient"
		]
	},
	"mixins": [
		"dtrmc.mixins.json",
		{
			"config": "dtrmc.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"plasmovoice": ">=2.1.17"
	}
}